# Secrets — never commit
.env
config/.env
*.key

# Data: the compliance record and its backups live on the machine, not in git
# Anchored to the repo root with a leading slash. Bare `exports/` and `backups/` match at
# ANY depth, which silently swallowed .hermes/skills/exports/ - a skill three cron jobs
# depend on. It was on the authoring machine and absent from every clone.
/data/
/backups/
/exports/
*.db
*.db-wal
*.db-shm

# Hermes Agent runtime state (session keys, caches). The WhatsApp session directory is
# equivalent to a logged-in WhatsApp account — back it up encrypted, never to git.
platforms/
*.session

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db
data/eval-*.db*

# Logs. Debug output from the IMAP/gateway paths can contain credentials and message
# bodies - keep the whole class out of git rather than judging each file.
*.log
