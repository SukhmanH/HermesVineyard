# THERE ARE TWO .env FILES AND THEY ARE NOT THE SAME FILE. Getting this wrong is silent:
#
#   <repo>/.env        the compliance kernel + scripts. vineyard_mcp/config.py loads it
#                      (load_dotenv(REPO_ROOT/'.env')), and scripts/listings_triage.py
#                      parses it directly. DB_PATH, MEDIA_DIR, EXPORT_DIR, BACKUP_DIR,
#                      IMAP_*, SMTP_*, MANAGER_EMAILS, LISTINGS_* and the WA/owner ids.
#
#   ~/.hermes/.env     Hermes Agent's own secrets. LLM keys (`hermes config set` routes
#                      them here automatically), and HEALTHCHECKS_URL, which heartbeat
#                      reads from this path specifically.
#
# Copy this file to BOTH and delete the half that does not apply. Secrets only; anything
# tunable belongs in config.yaml or config/settings.yaml.
# Note there are no WA_* variables: Baileys authenticates by QR pairing and its session state
# lives in ~/.hermes/platforms/whatsapp/session (chmod 700, treat as a secret, back it up).

TZ=America/Vancouver

# ── Compliance kernel (repo .env) ──
# ABSOLUTE paths to YOUR checkout - a cron-spawned run has no working directory you can
# rely on. The live host is /home/waris/hermes-vineyard; /opt was only ever an example.
# EXPORT_DIR and BACKUP_DIR must stay under data/ unless you change build_exports.py too.
DB_PATH=/home/waris/hermes-vineyard/data/hermes.db
MEDIA_DIR=/home/waris/hermes-vineyard/data/media
EXPORT_DIR=/home/waris/hermes-vineyard/data/exports
BACKUP_DIR=/home/waris/hermes-vineyard/data/backups

# ── LLM: 9router over Tailscale ──
LLM_BASE_URL=http://172.16.33.5:20128/v1
LLM_API_KEY=
LLM_MODEL=                    # PIN a specific model — no free/auto combos in production

# ── Punjabi (§D11) ──
# IN : gateway faster-whisper, large-v3 pinned. Rough on Punjabi but confined to task logs;
#      the applicator types SPRAY reports in English, so compliance never touches ASR.
# OUT: Gurmukhi text, plus spoken Punjabi via Google Cloud TTS (tools/punjabi-tts/, voice
#      pa-IN-Chirp3-HD-Puck). Free under 1M chars/month; auth is Application Default
#      Credentials, not a key here:  gcloud auth application-default login
#      Edge TTS has NO pa-IN voice. Do NOT use facebook/mms-tts-pan — CC-BY-NC, non-commercial.
# OPTIONAL UPGRADE, not required: better Punjabi ASR (~$3-10/mo) if free proves too rough.
# Signal to watch: correction turns per report climbing, or workers routing around Hermes.
SARVAM_API_KEY=

# ── Weather ──
# ECCC is primary and needs no key. Set the Open-Meteo key ONLY with a commercial licence:
# the free tier is non-commercial and this is a commercial operation.
OPEN_METEO_API_KEY=

# ── Listings inbox ──
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=
LISTINGS_ALLOWED_SENDERS=noreply@zealty.ca,*@matrix.crea.ca
# The listings_poll cron job's id on THIS host. setup-jobs.sh mints new ids per host, so read
# it from `hermes cron list` after running setup-jobs and set it here. REQUIRED: the script
# now refuses to run without it rather than guessing, because a wrong id means the notepad
# belongs to no job, dedupe silently does nothing, and the same MLS numbers get re-reported
# until the owner learns to ignore listings entirely.
LISTINGS_JOB_ID=

# ── Outbound email (manager backup + attachments) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MANAGER_EMAILS=

# ── Ops ──
OWNER_WA=+1250XXXXXXX
OWNER_EMAIL=
CREW_GROUP_JID=               # captured at WhatsApp pairing; used by cron/setup-jobs.sh
# The complete healthchecks.io ping URL (https://hc-ping.com/<uuid>). The heartbeat reads
# this, falling back to reading ~/.hermes/.env directly because cron-spawned runs do not
# inherit the shell environment. Set the check to Period 15 min / Grace 5 min so the alarm
# fires ~20 min after the watchdog dies.
HEALTHCHECKS_URL=
# Deprecated older form: a base URL with "/heartbeat" appended. Only heartbeat.sh reads it.
HEALTHCHECKS_BASE_URL=
